* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

# Linux/A800 entry points must never acquire Windows CRLF endings.
*.sh text eol=lf

# Keep source, configs, and research records byte-stable across hosts.
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf

# A patch is matched byte-for-byte against sources that are eol=lf above, so a
# CRLF working-tree copy of one cannot apply. Verified 2026-09-10: the CRLF copy
# of read_outcome_repair.patch dies with "patch does not apply" at the first
# hunk. Without this line *.patch falls to "* text=auto" and core.autocrlf.
*.patch text eol=lf
*.diff text eol=lf

# Native Windows entry points use conventional CRLF working-tree endings.
*.ps1 text eol=crlf
